# Copy to .env and fill in. .env is gitignored and must never be committed.

# LLM provider
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Embeddings
EMBEDDING_MODEL=
EMBEDDING_PROVIDER=

# Retrieval configuration
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
USE_HYBRID=true
USE_RERANK=false

# Paths
RAW_DATA_DIR=data/raw
GOLDEN_SET=data/golden/questions.jsonl
RESULTS_DIR=results
